---
import "../styles/global.css";
import { SiteChrome } from "@/components/SiteChrome";
import { Sidebar } from "@/components/Sidebar";
import { SearchPalette } from "@/components/SearchPalette";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Cosmic UI - Sci-Fi UI Components for React and Vue",
  description = "A free, open-source library of sci-fi themed UI components for React and Vue. Angular frames, glowing borders, and futuristic HUD styling, ready to drop into your app.",
} = Astro.props;

// Every shared link (X, Reddit, Discord, Slack) renders from these tags. This
// project sells on how it looks, so the card image is not optional.
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/preview.jpeg", Astro.site);

const cfBeaconToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400..900&family=Roboto:ital,wght@0,100..900;1,100..900&display=swap"
      rel="stylesheet"
    />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Cosmic UI" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1600" />
    <meta property="og:image:height" content="1062" />
    <meta property="og:image:alt" content="Cosmic UI sci-fi components: angular frames, glowing borders, and HUD-style dashboard cards." />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@rizzznme" />
    <meta name="twitter:creator" content="@rizzznme" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {cfBeaconToken && (
      <script
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={`{"token": "${cfBeaconToken}"}`}
      />
    )}
  </head>
  <body class="min-h-screen before:fixed before:inset-0 before:bg-noise before:z-[-1] after:bg-temper after:opacity-15 after:bg-contain after:fixed after:inset-0 after:blur-xl after:z-[-1]">
    <div class="before:fixed before:inset-x-0 before:top-0 before:h-80 before:bg-gradient-to-b before:from-black/50 before:to-transparent before:z-[-1]">
      <SiteChrome client:load />
      <SearchPalette client:idle />
      <div class="container mx-auto px-4 sm:px-0">
        <Sidebar client:load currentPath={Astro.url.pathname} />
        <slot />
        <div class="text-center text-foreground/60 mt-24 mb-20">
          Powered by synthetic caffeine &middot; Deployed by{" "}
          <a
            href="https://github.com/rizznme"
            target="_blank"
            class="font-medium text-foreground/70"
          >
            Left4code
          </a>{" "}
          &middot; Signal traceable on{" "}
          <a
            href="https://github.com/rizznme/cosmic-ui"
            target="_blank"
            class="font-medium text-foreground/70"
          >
            GitHub
          </a>
          .
        </div>
      </div>
    </div>
    <script is:inline>
      // Draws every Frame's border before React/Vue ever loads, using the raw
      // path data each <svg data-frame-paths> carries on itself (see
      // src/components/ui/frame.tsx). Without this, every frame is empty
      // markup until the framework bundle downloads and hydrates - on a
      // throttled connection that's the difference between text-with-borders
      // and bare text for the better part of a second.
      //
      // This is a faithful port of @left4code/svg-renderer's own
      // createSvgElement/createSvgPaths - kept in sync manually since it has
      // no browser-less way to import from that package here. Drawing sets
      // data-width/data-height to the exact size just measured, which is
      // what setupSvgRenderer's own "has the size actually changed" guard
      // checks before it redraws - so once React/Vue mounts and measures the
      // same layout, it finds a match and leaves these paths alone instead
      // of tearing them down and redrawing.
      (function () {
        function evaluateArithmetic(source) {
          var tokens = source.match(/\d+\.?\d*|[+\-*/()]/g);
          if (!tokens || tokens.join("") !== source.replace(/\s+/g, "")) return 0;
          var pos = 0;
          function peek() {
            return tokens[pos];
          }
          function eat(t) {
            return peek() === t ? (pos++, true) : false;
          }
          function parseExpr() {
            var value = parseTerm();
            for (;;) {
              if (eat("+")) value += parseTerm();
              else if (eat("-")) value -= parseTerm();
              else return value;
            }
          }
          function parseTerm() {
            var value = parseFactor();
            for (;;) {
              if (eat("*")) value *= parseFactor();
              else if (eat("/")) {
                var divisor = parseFactor();
                value = divisor === 0 ? NaN : value / divisor;
              } else return value;
            }
          }
          function parseFactor() {
            if (eat("-")) return -parseFactor();
            if (eat("+")) return parseFactor();
            if (eat("(")) {
              var value = parseExpr();
              if (!eat(")")) return NaN;
              return value;
            }
            var token = peek();
            if (token === undefined || !/^\d/.test(token)) return NaN;
            pos++;
            return parseFloat(token);
          }
          var result = parseExpr();
          if (pos !== tokens.length || !isFinite(result)) return 0;
          return result;
        }

        function evalExpression(expr, width, height) {
          var replaced = expr
            .replace(/([\d.]+)%/g, function (_, num) {
              return "(" + parseFloat(num) + " / 100)";
            })
            .replace(/width/g, String(width))
            .replace(/height/g, String(height));
          return evaluateArithmetic(replaced);
        }

        function buildPathD(pathCmds, width, height) {
          return pathCmds
            .map(function (cmd) {
              var c = cmd[0],
                x = cmd[1],
                y = cmd[2];
              var px =
                x.indexOf("%") !== -1 || /[+\-*/]/.test(x)
                  ? evalExpression(x.replace(/%/g, "* width / 100"), width, height)
                  : parseFloat(x);
              var py =
                y.indexOf("%") !== -1 || /[+\-*/]/.test(y)
                  ? evalExpression(y.replace(/%/g, "* height / 100"), width, height)
                  : parseFloat(y);
              return c + " " + Math.trunc(px) + "," + Math.trunc(py);
            })
            .join(" ");
        }

        function drawFrame(svg) {
          var raw = svg.getAttribute("data-frame-paths");
          if (!raw) return;
          var paths;
          try {
            paths = JSON.parse(raw);
          } catch (e) {
            return;
          }

          var rect = svg.getBoundingClientRect();
          var width = rect.width,
            height = rect.height;
          // Not laid out yet (e.g. inside a display:none tab panel) - leave
          // it for React/Vue's own ResizeObserver to catch once it's shown.
          if (!width || !height) return;

          // Deliberately paint this as a CSS background rather than appending
          // real <path> children. Appending children to an element React
          // server-rendered as empty is a structural hydration mismatch and
          // makes React log error #418 on every page load.
          //
          // Touching the element at all is still visible to hydration: React
          // renders no `style` here, so it reports the paint as an unexpected
          // attribute (a `data-` attribute instead is reported just the same -
          // both were measured). Frame carries `suppressHydrationWarning` for
          // exactly this reason; its contents are drawn imperatively, so the
          // server markup is never meant to match.
          //
          // Custom properties don't resolve inside a data: URI (it's an
          // isolated document), so read each var()'s computed value off the
          // real element first and inline the concrete color.
          var cs = getComputedStyle(svg);
          function resolveColor(value) {
            var m = /^var\((--[^)]+)\)$/.exec(value || "");
            return m ? cs.getPropertyValue(m[1]).trim() : value;
          }

          // Every path gets painted, including ones flagged `"show": false`.
          // That flag is design-time data left over from the frame editor:
          // setupSvgRenderer has no concept of it and draws the whole array,
          // so skipping them here made this stand-in disagree with the real
          // render. The two frames on the home page whose border lives in a
          // `show: false` path drew as bare text until hydration, then had the
          // border pop in - exactly the flicker this script exists to prevent.
          var inner = "";
          for (var i = 0; i < paths.length; i++) {
            var p = paths[i];
            inner +=
              '<path d="' +
              buildPathD(p.path, width, height) +
              '" fill="' +
              resolveColor(p.style.fill) +
              '" stroke="' +
              resolveColor(p.style.stroke) +
              '" stroke-width="' +
              p.style.strokeWidth +
              '" shape-rendering="geometricPrecision"/>';
          }
          if (!inner) return;

          var doc =
            '<svg xmlns="http://www.w3.org/2000/svg" width="' +
            width +
            '" height="' +
            height +
            '">' +
            inner +
            "</svg>";
          svg.style.backgroundImage = 'url("data:image/svg+xml,' + encodeURIComponent(doc) + '")';
          svg.style.backgroundRepeat = "no-repeat";

          // Hand off cleanly: the moment setupSvgRenderer appends its own real
          // <path>s (once the framework bundle has loaded and mounted Frame),
          // drop the stand-in so the two can never both be visible.
          var observer = new MutationObserver(function () {
            if (!svg.querySelector("path")) return;
            svg.style.backgroundImage = "";
            svg.style.backgroundRepeat = "";
            observer.disconnect();
          });
          observer.observe(svg, { childList: true });
        }

        var svgs = document.querySelectorAll("svg[data-frame-paths]");
        for (var i = 0; i < svgs.length; i++) drawFrame(svgs[i]);
      })();
    </script>
  </body>
</html>
