---
const frameworkMatch = Astro.url.pathname.match(/^\/docs\/(react|vue)(\/|$)/);
const framework = frameworkMatch?.[1];
---

<div
  class="p-7 sm:p-10 lg:px-20 lg:py-14 sm:mx-10 lg:ml-0 xl:mr-0 col-span-10 xl:col-span-8 border border-primary/20 bg-primary/5"
  data-pagefind-body
  data-pagefind-filter={framework ? `framework:${framework}` : undefined}
>
  <div class="flex flex-col gap-20">
    <slot />
  </div>
</div>
