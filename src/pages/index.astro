---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Title from "@/components/docs/Title.astro";
import Subtitle from "@/components/docs/Subtitle.astro";
import ComponentCard from "@/components/docs/ComponentCard.astro";
import ComponentGrid from "@/components/docs/ComponentGrid.astro";
import { FrameworkSwitcher } from "@/components/FrameworkSwitcher";
import { Button } from "@/components/ui/button";

// Astro's client:* directives need the JSX tag to be an identifier bound
// directly by a static `import` - not a loop variable, not a destructured
// object/array property, no indirection at all. Tried all three (an
// import.meta.glob lookup, a Record<string, Component> keyed by slug, a
// plain array of imports mapped over) and every one failed the exact same
// way at build time: "NoMatchingImport: Could not render `Demo`". So this
// list is written out by hand instead of generated from docLinks, and its
// order is not the sidebar's. Dense packing only backfills a hole with a card
// that comes *after* it, so small cards have to stay available late or the
// leftover cells strand themselves mid-grid. Sorting big-first satisfies that
// but stacks every 1x1 in a dull block at the bottom, so instead the two sizes
// alternate roughly two-and-two, with the last three 1x1s held back as the
// final mop-up. Measured: same 18 rows and same 3 leftover cells at the end as
// a strict big-first sort, but 8 rows mixing sizes instead of 1.
//
// When adding a card, drop it near cards of its own size rather than at the
// end, and leave the trailing 1x1s trailing.
import { AccordionDemo } from "@/components/demos/react/accordion";
import { AlertDialogDemo } from "@/components/demos/react/alert-dialog";
import { AlertDemo } from "@/components/demos/react/alert";
import { AvatarDemo } from "@/components/demos/react/avatar";
import { BreadcrumbDemo } from "@/components/demos/react/breadcrumb";
import { ButtonGroupDemo } from "@/components/demos/react/button-group";
import { ButtonDemo } from "@/components/demos/react/button";
import { CalendarDemo } from "@/components/demos/react/calendar";
import { ChartDemo } from "@/components/demos/react/chart";
import { CheckboxDemo } from "@/components/demos/react/checkbox";
import { ComboboxDemo } from "@/components/demos/react/combobox";
import { DatepickerDemo } from "@/components/demos/react/datepicker";
import { DaterangepickerDemo } from "@/components/demos/react/daterangepicker";
import { DialogDemo } from "@/components/demos/react/dialog";
import { FrameDemo } from "@/components/demos/react/frame";
import { InputDemo } from "@/components/demos/react/input";
import { MenuDemo } from "@/components/demos/react/menu";
import { NumberInputDemo } from "@/components/demos/react/number-input";
import { PaginationDemo } from "@/components/demos/react/pagination";
import { RadioGroupDemo } from "@/components/demos/react/radio-group";
import { SelectDemo } from "@/components/demos/react/select";
import { SheetDemo } from "@/components/demos/react/sheet";
import { SwitchDemo } from "@/components/demos/react/switch";
import { TableDemo } from "@/components/demos/react/table";
import { TabsDemo } from "@/components/demos/react/tabs";
import { TextareaDemo } from "@/components/demos/react/textarea";
import { ToastDemo } from "@/components/demos/react/toast";

import AccordionDemoVue from "@/components/demos/vue/accordion.vue";
import AlertDialogDemoVue from "@/components/demos/vue/alert-dialog.vue";
import AlertDemoVue from "@/components/demos/vue/alert.vue";
import AvatarDemoVue from "@/components/demos/vue/avatar.vue";
import BreadcrumbDemoVue from "@/components/demos/vue/breadcrumb.vue";
import ButtonGroupDemoVue from "@/components/demos/vue/button-group.vue";
import ButtonDemoVue from "@/components/demos/vue/button.vue";
import CalendarDemoVue from "@/components/demos/vue/calendar.vue";
import ChartDemoVue from "@/components/demos/vue/chart.vue";
import CheckboxDemoVue from "@/components/demos/vue/checkbox.vue";
import ComboboxDemoVue from "@/components/demos/vue/combobox.vue";
import DatepickerDemoVue from "@/components/demos/vue/datepicker.vue";
import DaterangepickerDemoVue from "@/components/demos/vue/daterangepicker.vue";
import DialogDemoVue from "@/components/demos/vue/dialog.vue";
import FrameDemoVue from "@/components/demos/vue/frame.vue";
import InputDemoVue from "@/components/demos/vue/input.vue";
import MenuDemoVue from "@/components/demos/vue/menu.vue";
import NumberInputDemoVue from "@/components/demos/vue/number-input.vue";
import PaginationDemoVue from "@/components/demos/vue/pagination.vue";
import RadioGroupDemoVue from "@/components/demos/vue/radio-group.vue";
import SelectDemoVue from "@/components/demos/vue/select.vue";
import SheetDemoVue from "@/components/demos/vue/sheet.vue";
import SwitchDemoVue from "@/components/demos/vue/switch.vue";
import TableDemoVue from "@/components/demos/vue/table.vue";
import TabsDemoVue from "@/components/demos/vue/tabs.vue";
import TextareaDemoVue from "@/components/demos/vue/textarea.vue";
import ToastDemoVue from "@/components/demos/vue/toast.vue";
---

<BaseLayout hideCredit>
  <div class="mt-30 font-roboto text-base min-h-screen">
    <section class="min-h-[62vh] flex items-center px-7 sm:px-10 lg:px-20 lg:grid lg:grid-cols-2 lg:gap-10">
      <div class="flex flex-col gap-6 max-w-xl">
        <h1 class="font-orbitron text-4xl sm:text-[2.9rem] leading-[1.3] font-bold text-shadow-lg text-shadow-primary">
          <span class="block">Ready-to-use</span>
          <span class="block">Futuristic</span>
          <span class="block">UI components</span>
        </h1>
        <p class="font-orbitron text-base md:text-lg leading-snug opacity-70">
          A curated set of futuristic UI components — reusable, customizable,
          and framework-friendly.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 mt-4">
          <a href="/docs">
            <Button client:load className="w-64 sm:w-56">Get Started</Button>
          </a>
          <a href="#components">
            <Button client:load variant="accent" className="w-64 sm:w-56">
              Browse Components
            </Button>
          </a>
        </div>
      </div>
      {/* Right column is deliberately empty - breathing room next to the
          hero text rather than a second piece of content. */}
    </section>
    <div id="components" class="mt-24 p-7 sm:p-10 lg:px-20 lg:py-14 border border-primary/20 bg-primary/5">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <Title>Components</Title>
          <Subtitle>
            Every component, live. Click Copy for the install command, or click a
            name to read its docs.
          </Subtitle>
        </div>
        {/*
          The only framework picker on this page now that the old marketing
          hero is gone - both grids below are rendered up front (React and
          Vue islands, side by side in the DOM), and this only flips which one
          is visible. See the <script> at the bottom: it's the same
          framework-store every other framework-aware control on the site
          already reads and writes, just applied to a `hidden` attribute
          instead of a redirect.
        */}
        <FrameworkSwitcher client:load currentPath="/" />
      </div>
      {/*
        Card sizes aren't guesses - each demo's natural size was measured in
        the browser and rounded up to the smallest span that clears it.
        Re-measure before changing one; a span that's too small silently
        turns into a scrollbar inside the card.
      */}
      <div data-fw-panel="react" data-pagefind-body data-pagefind-filter="framework:react">
        <ComponentGrid>
          <ComponentCard slug="frame" label="Frame" installName="frame" framework="react" cols={2} rows={3} linkTo="search">
            <FrameDemo client:visible slot="preview" />
          </ComponentCard>
          <ComponentCard slug="alert" label="Alert" installName="alert" framework="react" cols={2} rows={2} linkTo="search">
            <AlertDemo client:visible slot="preview" />
          </ComponentCard>
          <ComponentCard slug="menu" label="Menu" installName="menu" framework="react" linkTo="search">
            <MenuDemo client:visible slot="preview" />
          </ComponentCard>
          <ComponentCard slug="dialog" label="Dialog" installName="dialog" framework="react" linkTo="search">
            <DialogDemo client:visible slot="preview" />
          </ComponentCard>
          <ComponentCard slug="accordion" label="Accordion" installName="accordion" framework="react" cols={2} rows={3} linkTo="search">
            <AccordionDemo client:visible slot="preview" />
          </ComponentCard>
          <ComponentCard slug="tabs" label="Tabs" installName="tabs" framework="react" cols={3} rows={2} linkTo="search">
            <TabsDemo client:visible slot="preview" />
          </ComponentCard>
          <ComponentCard slug="toast" label="Toast" installName="toast" framework="react" linkTo="search">
            <ToastDemo client:visible slot="preview" />
          </ComponentCard>
          <ComponentCard slug="button" label="Button" installName="button" framework="react" cols={2} linkTo="search">
            <ButtonDemo client:visible slot="preview" />
          </ComponentCard>
          <ComponentCard slug="radio-group" label="Radio Group" installName="radio-group" framework="react" rows={2} linkTo="search">
            <RadioGroupDemo client:visible slot="preview" />
          </ComponentCard>
          <ComponentCard slug="chart" label="Chart" installName="chart" framework="react" cols={2} rows={2} linkTo="search">
            <ChartDemo client:visible slot="preview" />
          </ComponentCard>
          <ComponentCard slug="combobox" label="Combobox" installName="combobox" framework="react" cols={2} linkTo="search">
            <ComboboxDemo client:visible slot="preview" />
          </ComponentCard>
          <ComponentCard slug="input" label="Input" installName="input" framework="react" linkTo="search">
            <InputDemo client:visible slot="preview" />
          </ComponentCard>
          <ComponentCard slug="switch" label="Switch" installName="switch" framework="react" linkTo="search">
            <SwitchDemo client:visible slot="preview" />
          </ComponentCard>
          <ComponentCard slug="select" label="Select" installName="select" framework="react" cols={2} linkTo="search">
            <SelectDemo client:visible slot="preview" />
          </ComponentCard>
          <ComponentCard slug="breadcrumb" label="Breadcrumb" installName="breadcrumb" framework="react" cols={2} linkTo="search">
            <BreadcrumbDemo client:visible slot="preview" />
          </ComponentCard>
          <ComponentCard slug="textarea" label="Textarea" installName="textarea" framework="react" linkTo="search">
            <TextareaDemo client:visible slot="preview" />
          </ComponentCard>
          <ComponentCard slug="checkbox" label="Checkbox" installName="checkbox" framework="react" linkTo="search">
            <CheckboxDemo client:visible slot="preview" />
          </ComponentCard>
          <ComponentCard slug="button-group" label="Button Group" installName="button-group" framework="react" cols={2} linkTo="search">
            <ButtonGroupDemo client:visible slot="preview" />
          </ComponentCard>
          <ComponentCard slug="calendar" label="Calendar" installName="date-picker" framework="react" cols={2} rows={2} linkTo="search">
            <CalendarDemo client:visible slot="preview" />
          </ComponentCard>
          <ComponentCard slug="alert-dialog" label="Alert Dialog" installName="alert-dialog" framework="react" linkTo="search">
            <AlertDialogDemo client:visible slot="preview" />
          </ComponentCard>
          <ComponentCard slug="avatar" label="Avatar" installName="avatar" framework="react" linkTo="search">
            <AvatarDemo client:visible slot="preview" />
          </ComponentCard>
          <ComponentCard slug="daterangepicker" label="Daterangepicker" installName="date-picker" framework="react" cols={2} linkTo="search">
            <DaterangepickerDemo client:visible slot="preview" />
          </ComponentCard>
          <ComponentCard slug="pagination" label="Pagination" installName="pagination" framework="react" cols={2} linkTo="search">
            <PaginationDemo client:visible slot="preview" />
          </ComponentCard>
          <ComponentCard slug="table" label="Table" installName="table" framework="react" cols={4} rows={2} linkTo="search">
            <TableDemo client:visible slot="preview" />
          </ComponentCard>
          <ComponentCard slug="datepicker" label="Datepicker" installName="date-picker" framework="react" linkTo="search">
            <DatepickerDemo client:visible slot="preview" />
          </ComponentCard>
          <ComponentCard slug="sheet" label="Sheet" installName="sheet" framework="react" linkTo="search">
            <SheetDemo client:visible slot="preview" />
          </ComponentCard>
          <ComponentCard slug="number-input" label="Number Input" installName="number-input" framework="react" linkTo="search">
            <NumberInputDemo client:visible slot="preview" />
          </ComponentCard>
        </ComponentGrid>
      </div>
      <div data-fw-panel="vue" data-pagefind-body data-pagefind-filter="framework:vue" hidden>
        <ComponentGrid>
          <ComponentCard slug="frame" label="Frame" installName="frame" framework="vue" cols={2} rows={3} linkTo="search">
            <FrameDemoVue client:visible slot="preview" />
          </ComponentCard>
          <ComponentCard slug="alert" label="Alert" installName="alert" framework="vue" cols={2} rows={2} linkTo="search">
            <AlertDemoVue client:visible slot="preview" />
          </ComponentCard>
          <ComponentCard slug="menu" label="Menu" installName="menu" framework="vue" linkTo="search">
            <MenuDemoVue client:visible slot="preview" />
          </ComponentCard>
          <ComponentCard slug="dialog" label="Dialog" installName="dialog" framework="vue" linkTo="search">
            <DialogDemoVue client:visible slot="preview" />
          </ComponentCard>
          <ComponentCard slug="accordion" label="Accordion" installName="accordion" framework="vue" cols={2} rows={3} linkTo="search">
            <AccordionDemoVue client:visible slot="preview" />
          </ComponentCard>
          <ComponentCard slug="tabs" label="Tabs" installName="tabs" framework="vue" cols={3} rows={2} linkTo="search">
            <TabsDemoVue client:visible slot="preview" />
          </ComponentCard>
          <ComponentCard slug="toast" label="Toast" installName="toast" framework="vue" linkTo="search">
            <ToastDemoVue client:visible slot="preview" />
          </ComponentCard>
          <ComponentCard slug="button" label="Button" installName="button" framework="vue" cols={2} linkTo="search">
            <ButtonDemoVue client:visible slot="preview" />
          </ComponentCard>
          <ComponentCard slug="radio-group" label="Radio Group" installName="radio-group" framework="vue" rows={2} linkTo="search">
            <RadioGroupDemoVue client:visible slot="preview" />
          </ComponentCard>
          <ComponentCard slug="chart" label="Chart" installName="chart" framework="vue" cols={2} rows={2} linkTo="search">
            <ChartDemoVue client:visible slot="preview" />
          </ComponentCard>
          <ComponentCard slug="combobox" label="Combobox" installName="combobox" framework="vue" cols={2} linkTo="search">
            <ComboboxDemoVue client:visible slot="preview" />
          </ComponentCard>
          <ComponentCard slug="input" label="Input" installName="input" framework="vue" linkTo="search">
            <InputDemoVue client:visible slot="preview" />
          </ComponentCard>
          <ComponentCard slug="switch" label="Switch" installName="switch" framework="vue" linkTo="search">
            <SwitchDemoVue client:visible slot="preview" />
          </ComponentCard>
          <ComponentCard slug="select" label="Select" installName="select" framework="vue" cols={2} linkTo="search">
            <SelectDemoVue client:visible slot="preview" />
          </ComponentCard>
          <ComponentCard slug="breadcrumb" label="Breadcrumb" installName="breadcrumb" framework="vue" cols={2} linkTo="search">
            <BreadcrumbDemoVue client:visible slot="preview" />
          </ComponentCard>
          <ComponentCard slug="textarea" label="Textarea" installName="textarea" framework="vue" linkTo="search">
            <TextareaDemoVue client:visible slot="preview" />
          </ComponentCard>
          <ComponentCard slug="checkbox" label="Checkbox" installName="checkbox" framework="vue" linkTo="search">
            <CheckboxDemoVue client:visible slot="preview" />
          </ComponentCard>
          <ComponentCard slug="button-group" label="Button Group" installName="button-group" framework="vue" cols={2} linkTo="search">
            <ButtonGroupDemoVue client:visible slot="preview" />
          </ComponentCard>
          <ComponentCard slug="calendar" label="Calendar" installName="date-picker" framework="vue" cols={2} rows={2} linkTo="search">
            <CalendarDemoVue client:visible slot="preview" />
          </ComponentCard>
          <ComponentCard slug="alert-dialog" label="Alert Dialog" installName="alert-dialog" framework="vue" linkTo="search">
            <AlertDialogDemoVue client:visible slot="preview" />
          </ComponentCard>
          <ComponentCard slug="avatar" label="Avatar" installName="avatar" framework="vue" linkTo="search">
            <AvatarDemoVue client:visible slot="preview" />
          </ComponentCard>
          <ComponentCard slug="daterangepicker" label="Daterangepicker" installName="date-picker" framework="vue" cols={2} linkTo="search">
            <DaterangepickerDemoVue client:visible slot="preview" />
          </ComponentCard>
          <ComponentCard slug="pagination" label="Pagination" installName="pagination" framework="vue" cols={2} linkTo="search">
            <PaginationDemoVue client:visible slot="preview" />
          </ComponentCard>
          <ComponentCard slug="table" label="Table" installName="table" framework="vue" cols={4} rows={2} linkTo="search">
            <TableDemoVue client:visible slot="preview" />
          </ComponentCard>
          <ComponentCard slug="datepicker" label="Datepicker" installName="date-picker" framework="vue" linkTo="search">
            <DatepickerDemoVue client:visible slot="preview" />
          </ComponentCard>
          <ComponentCard slug="sheet" label="Sheet" installName="sheet" framework="vue" linkTo="search">
            <SheetDemoVue client:visible slot="preview" />
          </ComponentCard>
          <ComponentCard slug="number-input" label="Number Input" installName="number-input" framework="vue" linkTo="search">
            <NumberInputDemoVue client:visible slot="preview" />
          </ComponentCard>
        </ComponentGrid>
      </div>
    </div>
    {/*
      Giant background wordmark, not a real heading - aria-hidden and
      select-none because it's decoration, not content a screen reader or a
      Ctrl+F search should ever land on. Outline-only via -webkit-text-stroke
      (no Tailwind utility for stroke-without-fill exists) with the fill set
      transparent, at the same primary color/opacity already used for every
      border on the site rather than a new one-off color.

      The "cut off by the window" look is a fixed-height, overflow-hidden
      wrapper shorter than the text's own line-height, not anything tied to
      actual scroll position - render height stays identical regardless of
      viewport height, where clipping against the real document edge would
      make the crop point different on every screen.

      Breaks out of BaseLayout's container (which caps around 1472px wide)
      with the w-screen/left-1/2/-translate-x-1/2 trick, rather than
      capping font-size to fit inside that width like earlier attempts
      did. There's no reason a decorative, aria-hidden element should be
      bound by the same max-width that keeps body text readable - and
      once its box is genuinely the full viewport, plain vw is safe at
      any width with no min() ceiling needed: "COSMIC UI" in this font
      measures out to ~5.83x its own font-size, so 17vw keeps textWidth
      at ~0.99x the viewport - just under, at every viewport, not only
      below whatever px value a cap happened to be set to.
    */}
    <div
      aria-hidden="true"
      class="relative left-1/2 -translate-x-1/2 w-screen mt-24 h-28 sm:h-40 lg:h-48 overflow-hidden select-none opacity-20"
    >
      <div
        class="text-center font-orbitron font-black leading-none whitespace-nowrap"
        style="font-size: 15.5vw; -webkit-text-stroke: 1px var(--color-primary); color: transparent;"
      >
        COSMIC UI
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  // The two panels above render both frameworks' cards up front (Astro's
  // client:* constraint means the demo tags can't be chosen dynamically -
  // see the import comment above), so switching framework here is purely a
  // visibility flip, not a fetch or a re-render. Read the same store every
  // other framework-aware control on the site already uses, so this stays in
  // sync with the sidebar's switcher, the top nav, and any /docs/<fw> page
  // reached directly.
  import { getFramework, subscribe } from "@/lib/framework-store";

  function applyFramework(fw: string) {
    document.querySelectorAll<HTMLElement>("[data-fw-panel]").forEach((el) => {
      el.hidden = el.dataset.fwPanel !== fw;
    });
  }

  applyFramework(getFramework());
  subscribe(() => applyFramework(getFramework()));
</script>
