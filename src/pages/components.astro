<script>
  // Same framework-visibility mechanism as home: both card sets render up
  // front, this only flips which is shown via the shared framework-store.
  import { getFramework, subscribe } from "@/lib/framework-store";

  function applyFramework(fw: string) {
    document.querySelectorAll<HTMLElement>("[data-fw-panel]").forEach((el) => {
      el.hidden = el.dataset.fwPanel !== fw;
    });
  }

  applyFramework(getFramework());
  subscribe(() => applyFramework(getFramework()));

  // Search: family-precise first, substring fallback - see the plan/commit
  // message for why a plain substring pass alone can't be the whole story.
  // "button" has to exclude "Button Group" even though that label contains
  // the word, which only a slug-shaped check (not a text-contains check)
  // can tell apart.
  function escapeRegExp(s: string) {
    return s.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
  }

  const searchInput = document.querySelector<HTMLInputElement>("#component-search");
  const noResults = document.querySelector<HTMLElement>("#no-results");

  function applyFilter(raw: string) {
    const q = raw.trim().toLowerCase();
    const cards = document.querySelectorAll<HTMLElement>("[data-slug]");

    if (!q) {
      cards.forEach((c) => (c.hidden = false));
      if (noResults) noResults.hidden = true;
      return;
    }

    const familyRe = new RegExp(`^${escapeRegExp(q)}(-\\d{2})?$`);
    let anyFamilyMatch = false;
    cards.forEach((c) => {
      if (familyRe.test((c.dataset.slug ?? "").toLowerCase())) anyFamilyMatch = true;
    });

    let visible = 0;
    cards.forEach((c) => {
      const slug = (c.dataset.slug ?? "").toLowerCase();
      const label = (c.dataset.label ?? "").toLowerCase();
      const show = anyFamilyMatch ? familyRe.test(slug) : label.includes(q);
      c.hidden = !show;
      if (show) visible++;
    });
    if (noResults) noResults.hidden = visible > 0;
  }

  const initialQuery = new URLSearchParams(location.search).get("q") ?? "";
  if (searchInput) searchInput.value = initialQuery;
  applyFilter(initialQuery);

  searchInput?.addEventListener("input", (e) => {
    const value = (e.target as HTMLInputElement).value;
    applyFilter(value);
    const url = new URL(location.href);
    if (value) url.searchParams.set("q", value);
    else url.searchParams.delete("q");
    history.replaceState(null, "", url);
  });
</script>
