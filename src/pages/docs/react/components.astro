---
import DocsLayout from "@/layouts/DocsLayout.astro";
import Title from "@/components/docs/Title.astro";
import Subtitle from "@/components/docs/Subtitle.astro";
import ComponentCard from "@/components/docs/ComponentCard.astro";
import ComponentGrid from "@/components/docs/ComponentGrid.astro";

// Astro's client:* directives need the JSX tag to be an identifier bound
// directly by a static `import` - not a loop variable, not a destructured
// object/array property, no indirection at all. Tried all three (an
// import.meta.glob lookup, a Record<string, Component> keyed by slug, a
// plain array of imports mapped over) and every one failed the exact same
// way at build time: "NoMatchingImport: Could not render `Demo`". So this
// list is written out by hand instead of generated from docLinks. Order is
// not the sidebar's: cards spanning more than one cell come first, then the
// 1x1s, each group in sidebar order. Dense packing only backfills a hole
// with a card that comes *after* it, so leaving the small cards till last is
// what lets them mop up the gaps - with the big ones last instead, the
// leftover cells strand themselves mid-grid. Add a card (plus the import
// above it) into whichever of the two groups matches its span.
import { AccordionDemo } from "@/components/demos/react/accordion";
import { AlertDialogDemo } from "@/components/demos/react/alert-dialog";
import { AlertDemo } from "@/components/demos/react/alert";
import { AvatarDemo } from "@/components/demos/react/avatar";
import { BreadcrumbDemo } from "@/components/demos/react/breadcrumb";
import { ButtonGroupDemo } from "@/components/demos/react/button-group";
import { ButtonDemo } from "@/components/demos/react/button";
import { Button01Demo } from "@/components/demos/react/button-01";
import { Button02Demo } from "@/components/demos/react/button-02";
import { Button03Demo } from "@/components/demos/react/button-03";
import { CalendarDemo } from "@/components/demos/react/calendar";
import { ChartDemo } from "@/components/demos/react/chart";
import { CheckboxDemo } from "@/components/demos/react/checkbox";
import { ComboboxDemo } from "@/components/demos/react/combobox";
import { DatepickerDemo } from "@/components/demos/react/datepicker";
import { DaterangepickerDemo } from "@/components/demos/react/daterangepicker";
import { DialogDemo } from "@/components/demos/react/dialog";
import { FrameDemo } from "@/components/demos/react/frame";
import { InputDemo } from "@/components/demos/react/input";
import { MenuDemo } from "@/components/demos/react/menu";
import { NumberInputDemo } from "@/components/demos/react/number-input";
import { PaginationDemo } from "@/components/demos/react/pagination";
import { RadioGroupDemo } from "@/components/demos/react/radio-group";
import { SelectDemo } from "@/components/demos/react/select";
import { SheetDemo } from "@/components/demos/react/sheet";
import { SwitchDemo } from "@/components/demos/react/switch";
import { TableDemo } from "@/components/demos/react/table";
import { TabsDemo } from "@/components/demos/react/tabs";
import { TextareaDemo } from "@/components/demos/react/textarea";
import { ToastDemo } from "@/components/demos/react/toast";
---

<DocsLayout title="Components | Cosmic UI">
  <div
    class="p-7 sm:p-10 lg:px-20 lg:py-14 sm:mx-10 lg:ml-0 xl:mr-0 col-span-10 border border-primary/20 bg-primary/5"
    data-pagefind-body
    data-pagefind-filter="framework:react"
  >
    <Title>Components</Title>
    <Subtitle>
      Every component, live. Click Copy for the install command, or click a
      name to read its docs.
    </Subtitle>
    {/*
      Card sizes aren't guesses - each demo's natural size was measured in the
      browser and rounded up to the smallest span that clears it. Re-measure
      before changing one; a span that's too small silently turns into a
      scrollbar inside the card.
    */}
    <ComponentGrid>
      <ComponentCard slug="frame" label="Frame" installName="frame" framework="react" cols={2} rows={3}>
        <FrameDemo client:visible slot="preview" />
      </ComponentCard>
      <ComponentCard slug="alert" label="Alert" installName="alert" framework="react" cols={2} rows={2}>
        <AlertDemo client:visible slot="preview" />
      </ComponentCard>
      <ComponentCard slug="accordion" label="Accordion" installName="accordion" framework="react" cols={2} rows={3}>
        <AccordionDemo client:visible slot="preview" />
      </ComponentCard>
      <ComponentCard slug="tabs" label="Tabs" installName="tabs" framework="react" cols={3} rows={2}>
        <TabsDemo client:visible slot="preview" />
      </ComponentCard>
      <ComponentCard slug="button" label="Button" installName="button" framework="react" cols={2}>
        <ButtonDemo client:visible slot="preview" />
      </ComponentCard>
      <ComponentCard slug="radio-group" label="Radio Group" installName="radio-group" framework="react" rows={2}>
        <RadioGroupDemo client:visible slot="preview" />
      </ComponentCard>
      <ComponentCard slug="chart" label="Chart" installName="chart" framework="react" cols={2} rows={2}>
        <ChartDemo client:visible slot="preview" />
      </ComponentCard>
      <ComponentCard slug="combobox" label="Combobox" installName="combobox" framework="react" cols={2}>
        <ComboboxDemo client:visible slot="preview" />
      </ComponentCard>
      <ComponentCard slug="select" label="Select" installName="select" framework="react" cols={2}>
        <SelectDemo client:visible slot="preview" />
      </ComponentCard>
      <ComponentCard slug="breadcrumb" label="Breadcrumb" installName="breadcrumb" framework="react" cols={2}>
        <BreadcrumbDemo client:visible slot="preview" />
      </ComponentCard>
      <ComponentCard slug="button-group" label="Button Group" installName="button-group" framework="react" cols={2}>
        <ButtonGroupDemo client:visible slot="preview" />
      </ComponentCard>
      <ComponentCard slug="calendar" label="Calendar" installName="date-picker" framework="react" cols={2} rows={2}>
        <CalendarDemo client:visible slot="preview" />
      </ComponentCard>
      <ComponentCard slug="daterangepicker" label="Daterangepicker" installName="date-picker" framework="react" cols={2}>
        <DaterangepickerDemo client:visible slot="preview" />
      </ComponentCard>
      <ComponentCard slug="pagination" label="Pagination" installName="pagination" framework="react" cols={2}>
        <PaginationDemo client:visible slot="preview" />
      </ComponentCard>
      <ComponentCard slug="table" label="Table" installName="table" framework="react" cols={4} rows={2}>
        <TableDemo client:visible slot="preview" />
      </ComponentCard>
      <ComponentCard slug="menu" label="Menu" installName="menu" framework="react">
        <MenuDemo client:visible slot="preview" />
      </ComponentCard>
      <ComponentCard slug="dialog" label="Dialog" installName="dialog" framework="react">
        <DialogDemo client:visible slot="preview" />
      </ComponentCard>
      <ComponentCard slug="toast" label="Toast" installName="toast" framework="react">
        <ToastDemo client:visible slot="preview" />
      </ComponentCard>
      <ComponentCard slug="button-01" label="Button · Outline" installName="button-01" framework="react">
        <Button01Demo client:visible slot="preview" />
      </ComponentCard>
      <ComponentCard slug="button-02" label="Button · Ghost" installName="button-02" framework="react">
        <Button02Demo client:visible slot="preview" />
      </ComponentCard>
      <ComponentCard slug="button-03" label="Button · Solid" installName="button-03" framework="react">
        <Button03Demo client:visible slot="preview" />
      </ComponentCard>
      <ComponentCard slug="input" label="Input" installName="input" framework="react">
        <InputDemo client:visible slot="preview" />
      </ComponentCard>
      <ComponentCard slug="switch" label="Switch" installName="switch" framework="react">
        <SwitchDemo client:visible slot="preview" />
      </ComponentCard>
      <ComponentCard slug="textarea" label="Textarea" installName="textarea" framework="react">
        <TextareaDemo client:visible slot="preview" />
      </ComponentCard>
      <ComponentCard slug="checkbox" label="Checkbox" installName="checkbox" framework="react">
        <CheckboxDemo client:visible slot="preview" />
      </ComponentCard>
      <ComponentCard slug="alert-dialog" label="Alert Dialog" installName="alert-dialog" framework="react">
        <AlertDialogDemo client:visible slot="preview" />
      </ComponentCard>
      <ComponentCard slug="avatar" label="Avatar" installName="avatar" framework="react">
        <AvatarDemo client:visible slot="preview" />
      </ComponentCard>
      <ComponentCard slug="datepicker" label="Datepicker" installName="date-picker" framework="react">
        <DatepickerDemo client:visible slot="preview" />
      </ComponentCard>
      <ComponentCard slug="sheet" label="Sheet" installName="sheet" framework="react">
        <SheetDemo client:visible slot="preview" />
      </ComponentCard>
      <ComponentCard slug="number-input" label="Number Input" installName="number-input" framework="react">
        <NumberInputDemo client:visible slot="preview" />
      </ComponentCard>
    </ComponentGrid>
  </div>
</DocsLayout>
