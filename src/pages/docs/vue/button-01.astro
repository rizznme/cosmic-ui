---
import DocsLayout from "@/layouts/DocsLayout.astro";
import InstallCommand from "@/components/docs/InstallCommand.astro";
import Wrapper from "@/components/docs/Wrapper.astro";
import TocMenu from "@/components/docs/TocMenu.astro";
import Title from "@/components/docs/Title.astro";
import Subtitle from "@/components/docs/Subtitle.astro";
import Preview from "@/components/docs/Preview.astro";
import SectionTitle from "@/components/docs/SectionTitle.astro";
import SectionContent from "@/components/docs/SectionContent.astro";
import PreviewCode from "@/components/docs/PreviewCode.astro";
import Button01Demo from "@/components/demos/vue/button-01.vue";

const previewCode = `
<Button01>Get Started</Button01>
`;

const uiSource = `
<script setup lang="ts">
import { twMerge } from "tailwind-merge";

defineOptions({ inheritAttrs: false });
const { class: className } = defineProps<{ class?: string }>();
</script>

<template>
  <button
    v-bind="$attrs"
    :class="
      twMerge([
        'px-6 py-2.5 font-medium cursor-pointer border border-primary text-primary bg-transparent transition-colors',
        'hover:bg-primary hover:text-primary-foreground',
        'disabled:opacity-40 disabled:pointer-events-none',
        className,
      ])
    "
  >
    <slot />
  </button>
</template>
`;

const usageImports = `
import Button01 from "@/components/ui/button-01.vue";
`;

const usageExample = `
<Button01>Get Started</Button01>
`;
---

<DocsLayout title="Button - Outline | Cosmic UI">
  <Wrapper>
    <div>
      <Title>Button · Outline</Title>
      <Subtitle>
        A variant of{" "}
        <a class="text-primary hover:text-shadow-lg hover:text-shadow-primary/50" href="/docs/vue/button">
          Button
        </a>{" "}
        - transparent with a colored border, fills solid on hover.
      </Subtitle>
      <Preview>
        <Button01Demo client:load slot="preview" />
        <PreviewCode slot="code" code={previewCode} />
      </Preview>
    </div>
    <div id="installation">
      <SectionTitle>Installation</SectionTitle>
      <InstallCommand component="button-01" />
      <SectionContent>
        No state machine, no Frame - this is a plain styled{" "}
        <span class="bg-foreground/15 px-1.5 py-px rounded-md">button</span>{" "}
        element, deliberately a different visual language from the default
        Button rather than another shape/color combination of it. Or copy
        and paste the code below by hand.
      </SectionContent>
      <PreviewCode title="components/ui/button-01.vue" code={uiSource} />
      <SectionContent>Update the import paths to match your project setup.</SectionContent>
    </div>
    <div id="usage">
      <SectionTitle>Usage</SectionTitle>
      <PreviewCode code={usageImports} />
      <PreviewCode code={usageExample} />
    </div>
  </Wrapper>
  <TocMenu>
    <a class="hover:text-foreground py-1" href="#installation">Installation</a>
    <a class="hover:text-foreground py-1" href="#usage">Usage</a>
  </TocMenu>
</DocsLayout>
