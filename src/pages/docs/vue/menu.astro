---

<DocsLayout title="Menu | Cosmic UI">
  <Wrapper>
    <div>
      <Title>Menu</Title>
      <Subtitle>Displays a button or a component that looks like a button.</Subtitle>
      <DocsLinks component="menu" framework="vue" />
      <Preview>
        <MenuDemo client:load slot="preview" />
        <PreviewCode slot="code" code={previewCode} />
      </Preview>
    </div>
    <div id="installation">
      <SectionTitle>Installation</SectionTitle>
      <InstallCommand component="menu" />
      <SectionContent>Install the following dependencies:</SectionContent>
      <InstallPackage>add @zag-js/menu @zag-js/vue @zag-js/presence</InstallPackage>
      <SectionContent>
        This component is built directly on the Zag.js state machine (not a
        wrapper), plus two small shared primitives used by every portal-based
        component in this library: an SSR-safe
        <span class="bg-foreground/15 px-1.5 py-px rounded-md">Portal</span>
        and a
        <span class="bg-foreground/15 px-1.5 py-px rounded-md">usePresence</span>
        composable that keeps content mounted through its exit animation. Vue
        SFCs can't export multiple components from one file, so Menu is a
        folder instead of a single file &mdash; copy all of it into your
        project.
      </SectionContent>
      <PreviewCode title="components/ui/portal.vue" code={portalSource} />
      <PreviewCode title="components/ui/presence.ts" code={presenceSource} />
      <SectionContent>Copy and paste the following folder into your project.</SectionContent>
      <PreviewCode title="components/ui/menu/context.ts" code={contextSource} />
      <PreviewCode title="components/ui/menu/MenuRoot.vue" code={rootSource} />
      <PreviewCode title="components/ui/menu/MenuTrigger.vue" code={triggerSource} />
      <PreviewCode title="components/ui/menu/MenuContent.vue" code={contentSource} />
      <PreviewCode title="components/ui/menu/MenuItem.vue" code={itemSource} />
      <PreviewCode title="components/ui/menu/index.ts" code={indexSource} />
      <SectionContent>Update the import paths to match your project setup.</SectionContent>
    </div>
    <div id="usage">
      <SectionTitle>Usage</SectionTitle>
      <PreviewCode code={usageImports} />
      <PreviewCode code={usageExample} />
    </div>
  </Wrapper>
  <TocMenu>
    <a class="hover:text-foreground py-1" href="#installation">Installation</a>
    <a class="hover:text-foreground py-1" href="#usage">Usage</a>
  </TocMenu>
</DocsLayout>
