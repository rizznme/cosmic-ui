---
import DocsLayout from "@/layouts/DocsLayout.astro";
import InstallCommand from "@/components/docs/InstallCommand.astro";
import Wrapper from "@/components/docs/Wrapper.astro";
import TocMenu from "@/components/docs/TocMenu.astro";
import Title from "@/components/docs/Title.astro";
import Subtitle from "@/components/docs/Subtitle.astro";
import DocsLinks from "@/components/docs/DocsLinks.astro";
import Preview from "@/components/docs/Preview.astro";
import SectionTitle from "@/components/docs/SectionTitle.astro";
import SectionContent from "@/components/docs/SectionContent.astro";
import InstallPackage from "@/components/docs/InstallPackage.astro";
import PreviewCode from "@/components/docs/PreviewCode.astro";
import AvatarDemo from "@/components/demos/vue/avatar.vue";

const previewCode = `
<AvatarRoot>
  <AvatarImage src="https://i.pravatar.cc/150?u=cosmic-ui" alt="User avatar" />
  <AvatarFallback>CU</AvatarFallback>
</AvatarRoot>
`;

const contextSource = `
import type { InjectionKey, ComputedRef } from "vue";
import type * as avatarMachine from "@zag-js/avatar";

type AvatarApi = ComputedRef<ReturnType<typeof avatarMachine.connect>>;

const AvatarApiKey: InjectionKey<AvatarApi> = Symbol("avatar-api");

export { AvatarApiKey };
export type { AvatarApi };
`;

const rootSource = `
<script setup lang="ts">
import { computed, provide, useAttrs, useId } from "vue";
import { useMachine, normalizeProps } from "@zag-js/vue";
import * as avatarMachine from "@zag-js/avatar";
import { twMerge } from "tailwind-merge";
import { AvatarApiKey } from "./context";

defineOptions({ inheritAttrs: false });
const rawAttrs = useAttrs() as Partial<avatarMachine.Props> & { class?: string };
const id = useId();

const machineProps = computed(() => {
  const { class: _class, ...rest } = rawAttrs;
  return { id, ...rest };
});
const service = useMachine(avatarMachine.machine, machineProps);
const api = computed(() => avatarMachine.connect(service, normalizeProps));

provide(AvatarApiKey, api);
</script>

<template>
  <span
    v-bind="api.getRootProps()"
    :class="
      twMerge([
        'relative inline-flex size-10 items-center justify-center overflow-hidden border border-primary/30 bg-primary/10',
        rawAttrs.class,
      ])
    "
  >
    <slot />
  </span>
</template>
`;

const imageSource = `
<script setup lang="ts">
import { inject } from "vue";
import { twMerge } from "tailwind-merge";
import { AvatarApiKey } from "./context";

const { src, alt, class: className } = defineProps<{
  src: string;
  alt: string;
  class?: string;
}>();

const injectedApi = inject(AvatarApiKey);
if (!injectedApi) throw new Error("Avatar parts must be used within <AvatarRoot>");
const api = injectedApi;
</script>

<template>
  <img
    v-bind="api.getImageProps()"
    :src="src"
    :alt="alt"
    :class="twMerge(['size-full object-cover', className])"
  />
</template>
`;

const fallbackSource = `
<script setup lang="ts">
import { inject } from "vue";
import { twMerge } from "tailwind-merge";
import { AvatarApiKey } from "./context";

defineProps<{ class?: string }>();

const injectedApi = inject(AvatarApiKey);
if (!injectedApi) throw new Error("Avatar parts must be used within <AvatarRoot>");
const api = injectedApi;
</script>

<template>
  <span v-bind="api.getFallbackProps()" :class="twMerge(['text-sm font-medium', $props.class])">
    <slot />
  </span>
</template>
`;

const indexSource = `
export { default as AvatarRoot } from "./AvatarRoot.vue";
export { default as AvatarImage } from "./AvatarImage.vue";
export { default as AvatarFallback } from "./AvatarFallback.vue";
`;

const usageImports = `
import { AvatarRoot, AvatarImage, AvatarFallback } from "@/components/ui/avatar";
`;

const usageExample = `
<AvatarRoot>
  <AvatarImage src="https://i.pravatar.cc/150?u=cosmic-ui" alt="User avatar" />
  <AvatarFallback>CU</AvatarFallback>
</AvatarRoot>
`;
---

<DocsLayout title="Avatar | Cosmic UI">
  <Wrapper>
    <div>
      <Title>Avatar</Title>
      <Subtitle>
        An image element with a fallback for representing a user.
      </Subtitle>
      <DocsLinks component="avatar" framework="vue" />
      <Preview>
        <AvatarDemo client:load slot="preview" />
        <PreviewCode slot="code" code={previewCode} />
      </Preview>
    </div>
    <div id="installation">
      <SectionTitle>Installation</SectionTitle>
      <InstallCommand component="avatar" />
      <SectionContent>Install the following dependencies:</SectionContent>
      <InstallPackage>add @zag-js/avatar @zag-js/vue</InstallPackage>
      <SectionContent>
        Built directly on the Zag.js state machine. The fallback and image
        both render unconditionally - the machine toggles a{" "}
        <span class="bg-foreground/15 px-1.5 py-px rounded-md">hidden</span>{" "}
        attribute on whichever one shouldn't show, based on whether the image
        loaded. The square border shown here is a placeholder; swap it for
        the{" "}
        <span class="bg-foreground/15 px-1.5 py-px rounded-md">Frame</span>{" "}
        primitive once its avatar-specific paths exist. Vue SFCs can't export
        multiple components from one file, so Avatar is a folder instead of a
        single file &mdash; copy all of it into your project.
      </SectionContent>
      <PreviewCode title="components/ui/avatar/context.ts" code={contextSource} />
      <PreviewCode title="components/ui/avatar/AvatarRoot.vue" code={rootSource} />
      <PreviewCode title="components/ui/avatar/AvatarImage.vue" code={imageSource} />
      <PreviewCode title="components/ui/avatar/AvatarFallback.vue" code={fallbackSource} />
      <PreviewCode title="components/ui/avatar/index.ts" code={indexSource} />
      <SectionContent>Update the import paths to match your project setup.</SectionContent>
    </div>
    <div id="usage">
      <SectionTitle>Usage</SectionTitle>
      <PreviewCode code={usageImports} />
      <PreviewCode code={usageExample} />
    </div>
  </Wrapper>
  <TocMenu>
    <a class="hover:text-foreground py-1" href="#installation">Installation</a>
    <a class="hover:text-foreground py-1" href="#usage">Usage</a>
  </TocMenu>
</DocsLayout>
