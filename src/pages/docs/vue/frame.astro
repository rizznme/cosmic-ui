---

<DocsLayout title="Frame | Cosmic UI">
  <Wrapper>
    <div>
      <Title>Frame</Title>
      <Subtitle>
        Displays a customizable SVG frame for buttons, modals, and UI components.
      </Subtitle>
      <Preview>
        <FrameDemo client:load slot="preview" />
        <PreviewCode slot="code" code={previewCode} />
      </Preview>
    </div>
    <div id="installation">
      <SectionTitle>Installation</SectionTitle>
      <SectionContent>Install the following dependencies:</SectionContent>
      <InstallPackage>add @left4code/svg-renderer</InstallPackage>
      <SectionContent>Copy and paste the following code into your project.</SectionContent>
      <PreviewCode title="components/ui/frame.vue" code={uiSource} />
      <SectionContent>Update the import paths to match your project setup.</SectionContent>
    </div>
    <div id="usage">
      <SectionTitle>Usage</SectionTitle>
      <PreviewCode code={usageImports} />
      <PreviewCode code={usageExample} />
    </div>
  </Wrapper>
  <TocMenu>
    <a class="hover:text-foreground py-1" href="#installation">Installation</a>
    <a class="hover:text-foreground py-1" href="#usage">Usage</a>
  </TocMenu>
</DocsLayout>
