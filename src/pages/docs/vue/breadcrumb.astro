---
import DocsLayout from "@/layouts/DocsLayout.astro";
import InstallCommand from "@/components/docs/InstallCommand.astro";
import Wrapper from "@/components/docs/Wrapper.astro";
import TocMenu from "@/components/docs/TocMenu.astro";
import Title from "@/components/docs/Title.astro";
import Subtitle from "@/components/docs/Subtitle.astro";
import Preview from "@/components/docs/Preview.astro";
import SectionTitle from "@/components/docs/SectionTitle.astro";
import SectionContent from "@/components/docs/SectionContent.astro";
import PreviewCode from "@/components/docs/PreviewCode.astro";
import BreadcrumbDemo from "@/components/demos/vue/breadcrumb.vue";

const previewCode = `
<BreadcrumbRoot>
  <BreadcrumbList>
    <BreadcrumbItem>
      <BreadcrumbLink href="/docs">Docs</BreadcrumbLink>
    </BreadcrumbItem>
    <BreadcrumbSeparator />
    <BreadcrumbItem>
      <BreadcrumbLink href="/docs/vue">Components</BreadcrumbLink>
    </BreadcrumbItem>
    <BreadcrumbSeparator />
    <BreadcrumbItem>
      <BreadcrumbPage>Breadcrumb</BreadcrumbPage>
    </BreadcrumbItem>
  </BreadcrumbList>
</BreadcrumbRoot>
`;

const rootSource = `
<script setup lang="ts">
// Astro forwards a slot="preview" used to route this island into a named
// slot as a genuine prop on whatever Vue renders at the top of that island.
// Without opting out of attribute inheritance, Vue falls that unrecognized
// prop through onto this root DOM node - and SSR and the client hydration
// script disagree on whether to do that, so it becomes a hydration mismatch
// on every page that mounts this component directly (as every demo does).
defineOptions({ inheritAttrs: false });
defineProps<{ class?: string }>();
</script>

<template>
  <nav aria-label="breadcrumb" :class="$props.class">
    <slot />
  </nav>
</template>
`;

const listSource = `
<script setup lang="ts">
import { twMerge } from "tailwind-merge";

const { class: className } = defineProps<{ class?: string }>();
</script>

<template>
  <ol :class="twMerge(['flex flex-wrap items-center gap-2 text-sm', className])">
    <slot />
  </ol>
</template>
`;

const itemSource = `
<script setup lang="ts">
import { twMerge } from "tailwind-merge";

const { class: className } = defineProps<{ class?: string }>();
</script>

<template>
  <li :class="twMerge(['flex items-center gap-2', className])">
    <slot />
  </li>
</template>
`;

const linkSource = `
<script setup lang="ts">
import { twMerge } from "tailwind-merge";

const { href, class: className } = defineProps<{ href: string; class?: string }>();
</script>

<template>
  <a :href="href" :class="twMerge(['text-foreground/50 hover:text-foreground', className])">
    <slot />
  </a>
</template>
`;

const pageSource = `
<script setup lang="ts">
import { twMerge } from "tailwind-merge";

const { class: className } = defineProps<{ class?: string }>();
</script>

<template>
  <span aria-current="page" :class="twMerge(['text-foreground', className])">
    <slot />
  </span>
</template>
`;

const separatorSource = `
<script setup lang="ts">
import { ChevronRight } from "@lucide/vue";
import { twMerge } from "tailwind-merge";

const { class: className } = defineProps<{ class?: string }>();
</script>

<template>
  <li role="presentation" aria-hidden="true" :class="twMerge(['text-foreground/30', className])">
    <ChevronRight class="size-3.5" />
  </li>
</template>
`;

const indexSource = `
export { default as BreadcrumbRoot } from "./BreadcrumbRoot.vue";
export { default as BreadcrumbList } from "./BreadcrumbList.vue";
export { default as BreadcrumbItem } from "./BreadcrumbItem.vue";
export { default as BreadcrumbLink } from "./BreadcrumbLink.vue";
export { default as BreadcrumbPage } from "./BreadcrumbPage.vue";
export { default as BreadcrumbSeparator } from "./BreadcrumbSeparator.vue";
`;

const usageImports = `
import {
  BreadcrumbRoot,
  BreadcrumbList,
  BreadcrumbItem,
  BreadcrumbLink,
  BreadcrumbPage,
  BreadcrumbSeparator,
} from "@/components/ui/breadcrumb";
`;

const usageExample = `
<BreadcrumbRoot>
  <BreadcrumbList>
    <BreadcrumbItem>
      <BreadcrumbLink href="/docs">Docs</BreadcrumbLink>
    </BreadcrumbItem>
    <BreadcrumbSeparator />
    <BreadcrumbItem>
      <BreadcrumbPage>Breadcrumb</BreadcrumbPage>
    </BreadcrumbItem>
  </BreadcrumbList>
</BreadcrumbRoot>
`;
---

<DocsLayout title="Breadcrumb | Cosmic UI">
  <Wrapper>
    <div>
      <Title>Breadcrumb</Title>
      <Subtitle>Displays the path to the current page.</Subtitle>
      <Preview>
        <BreadcrumbDemo client:load slot="preview" />
        <PreviewCode slot="code" code={previewCode} />
      </Preview>
    </div>
    <div id="installation">
      <SectionTitle>Installation</SectionTitle>
      <InstallCommand component="breadcrumb" />
      <SectionContent>
        No state machine here - a breadcrumb trail doesn't need one, it's
        plain semantic markup (<span class="bg-foreground/15 px-1.5 py-px rounded-md">nav</span>
        {" > "}<span class="bg-foreground/15 px-1.5 py-px rounded-md">ol</span>
        {" > "}<span class="bg-foreground/15 px-1.5 py-px rounded-md">li</span>).
        Vue SFCs can't export multiple components from one file, so
        Breadcrumb is a folder instead of a single file &mdash; copy all of
        it into your project.
      </SectionContent>
      <PreviewCode title="components/ui/breadcrumb/BreadcrumbRoot.vue" code={rootSource} />
      <PreviewCode title="components/ui/breadcrumb/BreadcrumbList.vue" code={listSource} />
      <PreviewCode title="components/ui/breadcrumb/BreadcrumbItem.vue" code={itemSource} />
      <PreviewCode title="components/ui/breadcrumb/BreadcrumbLink.vue" code={linkSource} />
      <PreviewCode title="components/ui/breadcrumb/BreadcrumbPage.vue" code={pageSource} />
      <PreviewCode title="components/ui/breadcrumb/BreadcrumbSeparator.vue" code={separatorSource} />
      <PreviewCode title="components/ui/breadcrumb/index.ts" code={indexSource} />
      <SectionContent>Update the import paths to match your project setup.</SectionContent>
    </div>
    <div id="usage">
      <SectionTitle>Usage</SectionTitle>
      <PreviewCode code={usageImports} />
      <PreviewCode code={usageExample} />
    </div>
  </Wrapper>
  <TocMenu>
    <a class="hover:text-foreground py-1" href="#installation">Installation</a>
    <a class="hover:text-foreground py-1" href="#usage">Usage</a>
  </TocMenu>
</DocsLayout>
