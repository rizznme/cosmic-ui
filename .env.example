# Cloudflare Web Analytics: dash.cloudflare.com -> Analytics & Logs -> Web Analytics
# -> Add a site (cosmic-ui.com, no DNS change needed) -> copy the token out of the
# snippet it gives you (the value inside data-cf-beacon='{"token":"..."}]').
PUBLIC_CF_BEACON_TOKEN=

# ConvertKit (Kit): app.kit.com -> Grow -> Landing Pages & Forms -> create a Form
# -> Settings tab has the Form ID (also in the form's URL) -> Account Settings ->
# Developer has the API Key (the public one, not the API Secret).
PUBLIC_CONVERTKIT_FORM_ID=
PUBLIC_CONVERTKIT_API_KEY=
